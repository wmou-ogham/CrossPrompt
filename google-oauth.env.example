# CrossPrompt @ https://crossprompt.mou.tw/
# Copy the two keys below into `.env` after creating the OAuth client.
#
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type: Web application
#   Name: CrossPrompt
#
#   Authorized JavaScript origins:
#     https://crossprompt.mou.tw
#
#   Authorized redirect URIs:
#     https://crossprompt.mou.tw/api/v1/auth/google/callback
#
# Also set in `.env` (required for OAuth redirects):
#   CROSSPROMPT_PUBLIC_BASE_URL=https://crossprompt.mou.tw
#   CROSSPROMPT_COOKIE_SECURE=true

CROSSPROMPT_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
CROSSPROMPT_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
