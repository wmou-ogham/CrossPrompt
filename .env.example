# Required in production.
CROSSPROMPT_ENV=production
CROSSPROMPT_PUBLIC_BASE_URL=https://crossprompt.example.com
CROSSPROMPT_ADMIN_USERNAME=admin
CROSSPROMPT_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE_WITH_GENERATED_HASH'
CROSSPROMPT_SESSION_SECRET=replace-with-at-least-32-random-characters
CROSSPROMPT_MASTER_KEY=replace-with-base64-encoded-32-bytes
CROSSPROMPT_IP_HASH_SALT=replace-with-at-least-24-random-characters

# Set both values to require Turnstile when creating a Vault.
CROSSPROMPT_TURNSTILE_SITE_KEY=
CROSSPROMPT_TURNSTILE_SECRET_KEY=

# TLS is terminated by the reverse proxy. Keep this true over public HTTPS.
CROSSPROMPT_COOKIE_SECURE=true
# Enable only when the reverse proxy replaces, rather than appends to, X-Forwarded-For.
CROSSPROMPT_TRUST_PROXY=false
CROSSPROMPT_PORT=8080
RUST_LOG=cross_prompt=info,tower_http=info
